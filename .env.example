# JARVIS .env – kopiere diese Datei nach .env und fülle die Werte aus

# Groq API (kostenlos auf groq.com registrieren)
GROQ_API_KEY=gsk_...

# PWA / iPhone API
JARVIS_API_TOKEN=         # Beliebiger geheimer String – muss in der PWA eingetragen werden
JARVIS_API_PORT=8080      # Port des lokalen API-Servers

# Optionale Cloud-Dienste
NOTION_TOKEN=             # Phase 2 – notion.so → Einstellungen → Integrationen

# Jarvis Konfiguration
JARVIS_NAME=Jarvis
JARVIS_WAKE_WORD=hey jarvis
JARVIS_LANGUAGE=de
JARVIS_LLM_MODEL=llama-3.3-70b-versatile
JARVIS_VOICE=de-DE-ConradNeural    # Deutsch. Alternativ: de-DE-KillianNeural

# Pfade (normalerweise nicht ändern nötig)
JARVIS_DB_PATH=./data/jarvis.db
JARVIS_CHROMA_PATH=./data/chroma
